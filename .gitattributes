* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.sql text eol=lf
# Los origenes simulados del padron los reescribe scripts/data/generate-demo.mjs
# siempre con LF. Sin eol=lf se extraen con CRLF en Windows y cada ejecucion de
# data:demo deja el arbol sucio sin que cambie el contenido.
*.csv text eol=lf
*.ndjson text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

