# Variables que necesita el proyecto, agrupadas por donde vive cada una.
# Copiar a .env para trabajo local. .env esta excluido por .gitignore.
#
# Ninguna variable de este fichero contiene un valor real: los secretos no se
# versionan ni siquiera con valor de ejemplo.

# --- Build: se inyectan al construir y viajan al navegador. No son secretas.
PUBLIC_BRAND_PROFILE=demo
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAELgOttEQExh7l1W

# --- Runtime del Worker: NO van aqui.
# Se declaran en app/wrangler.jsonc si no son secretas, o se cargan con
# `wrangler secret put <NOMBRE>` si lo son. Se listan para que se sepa que
# existen y que el Worker falla de forma controlada si faltan.
#
#   TURNSTILE_SECRET_KEY         secreto. Verificacion servidor a servidor de
#                                Turnstile. Sin el, la API responde 503.
#   TURNSTILE_EXPECTED_HOSTNAME  no secreta, ya en wrangler.jsonc.
#   TURNSTILE_EXPECTED_ACTION    no secreta, ya en wrangler.jsonc.
#   ALLOWED_FRAME_ANCESTORS      no secreta, opcional. Origenes HTTPS
#                                autorizados a incrustar la aplicacion,
#                                separados por comas. Sin valor, la CSP usa
#                                frame-ancestors 'none'.

# --- Scripts locales de datos: solo para pnpm run data:import:check.
# Token de minimo privilegio con acceso a D1, nunca la Global API Key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# --- Verificacion posterior al despliegue: pnpm run security:smoke:live.
# Si se omite, el script usa el dominio publico de la demo.
DEMO_BASE_URL=https://enfermeros-demo.yersongallardo.com
