{
  "name": "conoce-tu-enfermero",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --test tests/*.test.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:demo": "node scripts/data/generate-demo.ts",
    "data:verify": "node scripts/data/verify-demo.ts",
    "data:import:check": "node scripts/data/import-d1.ts data/demo/canonical/padron-snapshot.json",
    "data:local:init": "node scripts/data/seed-local-d1.ts",
    "deploy:config": "node scripts/deploy/wrangler-config.ts",
    "security:smoke:live": "node scripts/security/smoke-live.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vinext": "1.4.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module"
}
